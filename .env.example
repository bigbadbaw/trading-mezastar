# Supabase (auth + per-user data). Get these from your Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket holding official tag images (see ADR-0003)
NEXT_PUBLIC_TAG_IMAGE_BUCKET_URL=
